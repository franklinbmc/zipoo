Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and folders directly, including API PHP files.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Public app routes.
  RewriteRule ^login/?$ pages/login.html [L]
  RewriteRule ^register/?$ pages/register.html [L]
  RewriteRule ^dashboard/?$ pages/dashboard.html [L]
  RewriteRule ^settings/?$ pages/settings.html [L]
  RewriteRule ^customers/?$ pages/customers.html [L]
  RewriteRule ^suppliers/?$ pages/suppliers.html [L]
  RewriteRule ^users/?$ pages/users.html [L]
  RewriteRule ^stock/?$ pages/stock.html [L]
  RewriteRule ^sales/?$ pages/sales.html [L]
  RewriteRule ^bank/?$ pages/bank.html [L]
  RewriteRule ^real-?estate/?$ pages/realestate.html [L]

  # SaaS admin routes.
  RewriteRule ^saas/?$ saas/index.html [L]
  RewriteRule ^saas/login/?$ saas/login.html [L]
  RewriteRule ^saas/dashboard/?$ saas/dashboard.html [L]
  RewriteRule ^saas/businesses/?$ saas/businesses.html [L]
  RewriteRule ^saas/users/?$ saas/users.html [L]
  RewriteRule ^saas/settings/?$ saas/settings.html [L]

  # PWA fallback for client-side navigation.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(?:css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2?|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(?:index\.html|manifest\.json|service-worker\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
